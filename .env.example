# ==============================================================================
# StudyDezk Environment Variables (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Auth & Database (Required for multi-device sync and RLS)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# Server-side service key for administrative API actions (if running server functions)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# 2. Open-Weight Model Layer (OpenAI-compatible chat completions)
# ------------------------------------------------------------------------------
# Primary Provider: Qwen3-32B on Groq
LLM_PROVIDER="groq"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY="gsk_your_groq_api_key"
LLM_MODEL="qwen-2.5-32b"

# Fallback 1: Gemma 2 / 4 on Cloudflare Workers AI
LLM_FALLBACK_1_PROVIDER="cloudflare"
LLM_FALLBACK_1_BASE_URL="https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1"
LLM_FALLBACK_1_API_KEY="your_cloudflare_api_token"
LLM_FALLBACK_1_MODEL="@cf/google/gemma-7b-it"

# Fallback 2: OpenRouter Free Open-Weight Tier
LLM_FALLBACK_2_PROVIDER="openrouter"
LLM_FALLBACK_2_BASE_URL="https://openrouter.ai/api/v1"
LLM_FALLBACK_2_API_KEY="sk-or-your_openrouter_key"
LLM_FALLBACK_2_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# ------------------------------------------------------------------------------
# 3. Optional Local / Studio Services
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
